msgid "Number of images at the top of the page loaded right away. The others wait until they are about to be seen. WordPress default: 3."
msgstr "Nombre d’images du haut de page chargées tout de suite. Les autres attendent d’être sur le point d’être vues. Par défaut dans WordPress : 3."

#: includes/class-isp-admin.php:555
#: includes/class-isp-admin.php:558
msgid "Empty alt in content"
msgstr "Alt vide dans les contenus"

#: includes/class-isp-admin.php:559
